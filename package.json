{
  "name": "openapi-to-zod-schema",
  "version": "2.0.0",
  "repository": "https://github.com/3rd/openapi-to-zod-schema",
  "author": {
    "name": "Andrei Neculaesei",
    "email": "3rd@users.noreply.github.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">24.11.0"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "bin": {
    "openapi-to-zod-schema": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:package": "node src/scripts/test-package.mjs",
    "tsc": "tsc",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build && pnpm run tsc && pnpm run test && pnpm run test:package"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "printWidth": 120,
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.5.0"
  }
}
